<p class="titulo-seccion">1.&nbsp; BIENES PROPIOS APORTADOS PARA LA EJECUCIÓN DEL PROYECTO <small>(mencione las maquinarias, herramientas, inmuebles e insumos y el valor en el estado actual de los mismos)</small></p>
<table class="tabla tabla-bienes">
    <colgroup><col style="width: 44.5%"><col style="width: 18.8%"><col style="width: 17%"><col style="width: 19.7%"></colgroup>
    <tr><th>Bienes</th><th>Cantidad</th><th>Antigüedad</th><th>Monto estimado</th></tr>
    <% filasBienes.forEach((fila) => { %>
    <tr>
        <td><%= fila.bien %></td>
        <td class="numero"><%= fila.cantidad || '' %></td>
        <td><%= fila.antiguedad %></td>
        <td class="numero"><%= moneda(fila.montoEstimado) %></td>
    </tr>
    <% }) %>
</table>

<p class="titulo-seccion">2.&nbsp; DESTINO DEL SUBSIDIO <small>(mencione los bienes solicitados en el proyecto)</small></p>
<p class="subtitulo-seccion">a) ACTIVO FIJO <small>(maquinarias y herramientas)</small></p>
<%- include('../tabla-solicitados.ejs', { filas: filasActivoFijo }) %>
