<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <title>Formulario de Subsidios no Reintegrables</title>
    <style><%- include('subsidio.css') %></style>
</head>
<body>
<%
// Cada hoja es un parcial que se envuelve con el marco común (logo, expediente y pie)
['portada', 'bienes', 'costos', 'acta', 'notificacion', 'declaracion'].forEach((nombreHoja, indice) => { %>
    <%- include('hoja.ejs', { numero: indice + 1, contenido: include(`hojas/${nombreHoja}.ejs`) }) %>
<% }) %>
</body>
</html>
