<p class="subtitulo-seccion">b) BIENES DE USO <small>(materia prima e insumos)</small></p>
<%- include('../tabla-solicitados.ejs', { filas: filasBienesUso }) %>

<% if (esCredito) { %>
<%# Crédito: como en la hoja oficial, un solo renglón con la suma de los dos cuadros %>
<div class="totales-solicitados">
    <p><strong>c) TOTAL SOLICITADO</strong> (sume los cuadros anteriores): <span class="relleno"><%= moneda(datos.totalProyectoSolicitado) %></span></p>
</div>
<% } else { %>
<div class="totales-solicitados">
    <p><strong>TOTAL SOLICITADO:</strong></p>
    <p>Activo Fijo: <span class="relleno"><%= moneda(datos.solicitadoActivoFijo) %></span></p>
    <p>Bienes de Uso: <span class="relleno"><%= moneda(datos.solicitadoBienesUso) %></span></p>
</div>
<% } %>

<p class="titulo-seccion titulo-costos">COSTO TOTAL DEL PROYECTO <span>(tenga en cuenta un ciclo de producción completo)</span></p>
<table class="tabla tabla-costos">
    <colgroup><col style="width: 39.7%"><col style="width: 26.9%"><col style="width: 33.4%"></colgroup>
    <tr><th></th><th>Aporte propio</th><th>Solicitado</th></tr>
    <tr>
        <td>Activo Fijo <small>(maquinarias y herramientas)</small></td>
        <td class="numero"><%= moneda(datos.aporteActivoFijo) %></td>
        <td class="numero"><%= moneda(datos.solicitadoActivoFijo) %></td>
    </tr>
    <tr>
        <td>Bienes de uso <small>(insumo y materia prima)</small></td>
        <td class="numero"><%= moneda(datos.aporteBienesUso) %></td>
        <td class="numero"><%= moneda(datos.solicitadoBienesUso) %></td>
    </tr>
    <tr>
        <td>Mano de obra</td>
        <td class="numero"><%= moneda(datos.aporteManoObra) %></td>
        <td class="gris"></td>
    </tr>
    <tr>
        <td>COSTO TOTAL DEL PROYECTO</td>
        <td class="numero"><%= moneda(datos.totalProyectoPropio) %></td>
        <td class="numero"><%= moneda(datos.totalProyectoSolicitado) %></td>
    </tr>
</table>

