# Copiar este archivo como ".env" y completar los valores. El .env nunca se sube al repositorio.
# Con Docker, docker-compose.yml toma de acá lo que necesita (ver DOCKER.md).

# --- Base de datos ---
# Contraseña de root de MySQL (solo Docker: la usa el contenedor de la base; la app no la recibe)
MYSQL_ROOT_PASSWORD=poner_una_clave_larga_para_root
# Usuario de la app: siempre ministerio_api (database/Usuario Conexion.sql). Con Docker, DB_HOST y DB_NAME los fija el compose
DB_HOST=localhost
DB_USER=ministerio_api
DB_PASS=poner_una_clave_larga_para_la_app
DB_NAME=ProyectoEmprendimientos2026

# --- App ---
# Puerto interno de Node (sin Docker). Con Docker, el puerto del servidor por el que se entra al sitio es PUERTO_PUBLICO
PORT=3000
PUERTO_PUBLICO=3000
# Dirección pública del sitio, sin barra final: se usa en los enlaces de los correos (ej: https://emprendedores.ejemplo.edu.ar)
APP_URL=http://localhost:3000
# Clave para firmar las sesiones: una cadena larga y aleatoria (ej: la salida de "openssl rand -hex 32")
JWT_SECRET=poner_una_cadena_larga_y_aleatoria
JWT_EXPIRES_IN=10m
# Si el sitio está detrás de un proxy (nginx, Apache, balanceador): 1 (o la cantidad de proxys); si no, false
TRUST_PROXY=false

# --- Correo (avisos a emprendedores, activación de cuentas, etc.) ---
# Cuenta que envía los correos. Con Gmail: la "contraseña de aplicación" de la cuenta (no la contraseña común)
SMTP_USER=
SMTP_PASS=
# Opcionales: por defecto Gmail (smtp.gmail.com, puerto 465)
SMTP_HOST=
SMTP_PORT=
# Nombre que ve quien recibe el correo
CORREO_REMITENTE=
